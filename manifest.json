{
  "manifest_version": 3,
  "name": "Recall v2.15 – Search What You've Watched",
  "short_name": "Recall v2.15",
  "version": "2.15.0",
  "description": "Semantic search over the YouTube videos you've watched. Type a vague memory, jump to the exact second. 100% on-device.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Recall",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/parse.js",
        "content/yt-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/scene-policy.js",
        "content/scene-capture.js",
        "content/screen-capture.js",
        "content/speech-capture.js",
        "content/yt-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/speech-worklet.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
