{
  "manifest_version": 3,
  "name": "CueWoven \u2013 Search Your History",
  "short_name": "CueWoven",
  "version": "3.3.35",
  "description": "Find watched videos, articles and searches from a vague memory. Optional website capture; local text, audio and scene search.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CueWoven",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "favicon",
    "unlimitedStorage",
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/parse.js",
        "content/yt-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "lib/scene-policy.js",
        "content/scene-capture.js",
        "content/screen-capture.js",
        "content/speech-capture.js",
        "content/yt-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+K"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/speech-worklet.js"
      ],
      "use_dynamic_url": true,
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
