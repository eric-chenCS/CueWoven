{
  "name": "recall-extension",
  "version": "3.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Recall: local semantic search over watched videos, articles and history, with optional website capture.",
  "type": "module",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile --ignore-scripts && pnpm run vendor",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test tests/*.test.mjs",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
